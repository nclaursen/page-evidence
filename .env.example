# Copy to a private env file. Never commit a populated file.
SITE_SIGNAL_PROFILE=example
SITE_DOMAIN=example.com
GSC_PROPERTY=sc-domain:example.com

# Select exactly one provider: ga4, matomo, engage, or none.
ANALYTICS_PROVIDER=ga4
GA4_PROPERTY_ID=123456789
GOOGLE_OAUTH_CLIENT_ID=1234567890-example.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-me

# Matomo alternative. Use an HTTPS URL and a read-only token.
# ANALYTICS_PROVIDER=matomo
# MATOMO_URL=https://analytics.example.com/
# MATOMO_SITE_ID=1
# MATOMO_TOKEN_AUTH=replace-with-read-only-token

# Umbraco Engage 17/18 alternative. Use an HTTPS base URL and an API user
# with Engage section access plus the minimum analytics read permission.
# ANALYTICS_PROVIDER=engage
# UMBRACO_BASE_URL=https://cms.example.com/
# UMBRACO_CLIENT_ID=site-signal
# UMBRACO_CLIENT_SECRET=replace-with-api-user-secret

# Optional. Defaults to ~/.site-signal (outside the current repository).
SITE_SIGNAL_DATA_DIR=/absolute/path/to/private/site-signal-data/example

# Optional MCP evidence extensions. Keep paths and values private.
# SITE_SIGNAL_REPOSITORY_PATH=/absolute/path/to/site-repository
# SITE_SIGNAL_SITEMAP_URL=https://example.com/sitemap.xml
# GA4_OUTCOME_EVENT_NAMES=generate_lead,form_submit
